@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam monochrome false

' === STANDARD LIGHT BLUE THEME ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' =================================

actor "Platform Administrator" as Admin

rectangle "RecruitSense Platform (UC-16: Moderate User Accounts)" {
    usecase "Manage User Account Moderation" as UC1
    usecase "Inspect Violation Logs\n& Reported Complaints" as UC2
    usecase "Update Account Status\nto 'Suspended'" as UC3
    usecase "Revoke Active Sanctum\nBearer Tokens" as UC4
    usecase "Dispatch Suspension Notice\n& Log Audit Event" as UC5
    usecase "Reinstate / Lift Suspension\nupon Appeal Review" as UC6
}

Admin --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<extend>>
@enduml
