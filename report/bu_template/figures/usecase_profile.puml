@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam monochrome false

' === STANDARD LIGHT BLUE THEME ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' =================================

actor "Job Seeker" as Candidate
actor "Corporate Recruiter" as Recruiter

rectangle "RecruitSense Platform (UC-18: Update Profile)" {
    usecase "Update Profile Information" as UC1
    usecase "Populate Current Profile\n& Portfolio Attributes" as UC2
    usecase "Validate Field Constraints\n& Social Links" as UC3
    usecase "Persist Changes to Database\n(job_seekers / companies)" as UC4
    usecase "Synchronize Client UI\nApplication State" as UC5
    usecase "Toggle Dark/Light\nTheme Preference" as UC6
}

Candidate --> UC1
Recruiter --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<extend>>
@enduml
