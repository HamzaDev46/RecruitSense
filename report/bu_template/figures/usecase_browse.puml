@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false

' === EXACT LIGHT BLUE THEME FROM YOUR SCREENSHOT ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor transparent
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' ===================================================

actor "Job Seeker" as User

rectangle "RecruitSense Platform (UC-01: Browse & Filter Jobs)" {
    usecase "Browse Active Vacancies" as UC1
    usecase "Apply Keyword Search" as UC2
    usecase "Filter by Type\n(Remote / Full-Time)" as UC3
    usecase "Filter by Location & Salary" as UC4
    usecase "View Vacancy Summary Cards" as UC5
}

User --> UC1
UC1 ..> UC2 : <<extend>>
UC1 ..> UC3 : <<extend>>
UC1 ..> UC4 : <<extend>>
UC1 ..> UC5 : <<include>>
@enduml
