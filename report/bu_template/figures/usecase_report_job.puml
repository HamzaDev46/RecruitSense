@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam monochrome false

' === STANDARD LIGHT BLUE THEME ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' =================================

actor "Job Seeker" as Candidate
actor "Platform Administrator" as Admin

rectangle "RecruitSense Platform (UC-19: Report Fraudulent Job)" {
    usecase "Submit Fraud Report for Job" as UC1
    usecase "Select Violation Category\n& Enter Remarks" as UC2
    usecase "Enforce Duplicate Report\nPrevention Checks" as UC3
    usecase "Persist Report Record\nin Database" as UC4
    usecase "Enqueue Flagged Job into\nAdmin Moderation Queue" as UC5
    usecase "Cancel Report Modal Form" as UC6
}

Candidate --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<extend>>

UC5 --> Admin
@enduml
