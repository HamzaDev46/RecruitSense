        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam shadowing false\nskinparam monochrome false\n\n&#39; === STANDARD LIGHT BLUE THEME ===\nskinparam backgroundColor #FFFFFF\n\nskinparam sequence {\n    ArrowColor #0284C7\n    ActorBorderColor #0284C7\n    ActorBackgroundColor #38BDF8\n    ActorFontColor #0F172A\n    \n    ParticipantBorderColor #0284C7\n    ParticipantBackgroundColor #BAE6FD\n    ParticipantFontColor #0F172A\n    ParticipantFontStyle bold\n    \n    LifeLineBorderColor #0284C7\n    LifeLineBackgroundColor #E0F2FE\n    \n    BoxBorderColor #0284C7\n    BoxBackgroundColor #F0F9FF\n    BoxFontColor #0284C7\n}\n&#39; =================================\n\nactor \&quot;New User\&quot; as User\nparticipant \&quot;React Web Client\\n(SPA)\&quot; as Client\nparticipant \&quot;Laravel Auth Engine\\n(AuthController)\&quot; as Auth\nparticipant \&quot;Domain Validator\\n(TrustedEmailDomain)\&quot; as Validator\ndatabase \&quot;MySQL Database\\n(users / roles)\&quot; as DB\n\nUser -&gt; Client: 1. Enter name, email, password, and select role (&#39;job_seeker&#39; / &#39;company&#39;)\nactivate Client\n\nClient -&gt; Auth: 2. POST /api/auth/register {name, email, password, role}\nactivate Auth\n\nalt Corporate Recruiter Registration\n    Auth -&gt; Validator: 3. Validate corporate email domain\n    activate Validator\n    Validator --&gt; Auth: 4. Domain verification passed (Non-disposable business domain)\n    deactivate Validator\nend\n\nAuth -&gt; DB: 5. Hash password (Bcrypt) &amp; INSERT into users &amp; profile tables\nactivate DB\nDB --&gt; Auth: 6. User record &amp; ID created\ndeactivate DB\n\nAuth -&gt; Auth: 7. Generate cryptographically signed Sanctum Bearer Token\n\nAuth --&gt; Client: 8. HTTP 201 Created {token, user: {id, name, role, status}}\ndeactivate Auth\n\nClient -&gt; Client: 9. Store Bearer token in secure client state\n\nClient --&gt; User: 10. Redirect user to role-specific dashboard\ndeactivate Client\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XBolDtDRK_nQilbLI28T-1">
