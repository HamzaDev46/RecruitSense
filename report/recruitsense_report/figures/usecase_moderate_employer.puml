@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam monochrome false

' === STANDARD LIGHT BLUE THEME ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' =================================

actor "Platform Administrator" as Admin

rectangle "RecruitSense Platform (UC-15: Moderate Employer Accounts)" {
    usecase "Audit Corporate Employer Accounts" as UC1
    usecase "Inspect Company Profile\n& Platform Metrics" as UC2
    usecase "Review Reported Job Vacancies\n& Fraud Flags" as UC3
    usecase "Update Status (Approve,\nFlag, or Suspend)" as UC4
    usecase "Deactivate Listings &\nRecord Audit Trail" as UC5
    usecase "Issue Formal Warning Notice" as UC6
}

Admin --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<extend>>
@enduml
