@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam monochrome false

' === STANDARD LIGHT BLUE THEME ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' =================================

actor "Corporate Recruiter" as Recruiter

rectangle "RecruitSense Platform (UC-10: Edit Job Vacancy)" {
    usecase "Modify Existing Job Vacancy" as UC1
    usecase "Verify Vacancy Ownership\nAuthorization" as UC2
    usecase "Populate Form with\nCurrent Vacancy Data" as UC3
    usecase "Validate Updated Fields\n& Skill Tags" as UC4
    usecase "Persist Updates to Database\n& Refresh Live Index" as UC5
    usecase "Archive or Close\nJob Listing" as UC6
}

Recruiter --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<extend>>
@enduml
