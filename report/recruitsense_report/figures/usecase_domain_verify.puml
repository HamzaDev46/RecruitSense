@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam monochrome false

' === STANDARD LIGHT BLUE THEME ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' =================================

actor "Platform Administrator" as Admin
actor "Validation Rule Engine" as ValEngine <<System>>

rectangle "RecruitSense Platform (UC-14: Verify Corporate Domain)" {
    usecase "Audit Corporate Email Domain" as UC1
    usecase "Extract Host Domain\nfrom Business Email" as UC2
    usecase "Check Disposable &\nPublic Domain Blacklist" as UC3
    usecase "Update Company Verified\nStatus in Database" as UC4
    usecase "Unlock Job Vacancy\nPublishing Privileges" as UC5
    usecase "Reject Fraudulent\nCompany Profile" as UC6
}

Admin --> UC1
ValEngine --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<extend>>
@enduml
