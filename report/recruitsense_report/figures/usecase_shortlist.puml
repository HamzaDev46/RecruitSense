@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam monochrome false

' === STANDARD LIGHT BLUE THEME ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' =================================

actor "Corporate Recruiter" as Recruiter

rectangle "RecruitSense Platform (UC-08: Review AI-Ranked Shortlist)" {
    usecase "Manage Candidate Shortlist" as UC1
    usecase "Query Applications Sorted\nby ATS Match Score" as UC2
    usecase "Filter Applicants by\nScore Threshold Slider" as UC3
    usecase "Inspect Extracted Resume\n& Profile Details" as UC4
    usecase "Compare Candidate\nSkill Distributions" as UC5
    usecase "Export Shortlisted\nCandidates to CSV" as UC6
}

Recruiter --> UC1

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<extend>>
@enduml
