@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam monochrome false

' === STANDARD LIGHT BLUE THEME ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' =================================

actor "Corporate Recruiter" as Recruiter

rectangle "RecruitSense Platform (UC-04: Create Job Vacancy)" {
    usecase "Create Job Vacancy Form" as UC1
    usecase "Define Job Details &\nWorkplace Type" as UC2
    usecase "Specify Required Skills\nTaxonomy Tags" as UC3
    usecase "Verify Corporate\nDomain Status" as UC4
    usecase "Publish to Public\nSearch Index" as UC5
}

Recruiter --> UC1
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
@enduml
