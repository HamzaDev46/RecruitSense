@startuml
left to right direction
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam monochrome false

' === STANDARD LIGHT BLUE THEME ===
skinparam backgroundColor #FFFFFF

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #0284C7
    FontColor #0284C7
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #BAE6FD
    BorderColor #0284C7
    FontColor #0F172A
    FontSize 12
}

skinparam actor {
    BackgroundColor #38BDF8
    BorderColor #0284C7
    FontColor #0F172A
}

skinparam arrow {
    Color #0284C7
    FontColor #0284C7
}
' =================================

actor "Job Seeker" as Candidate
actor "AI Screening Engine" as AIService <<System>>

rectangle "RecruitSense Platform (UC-05: Submit Job Application)" {
    usecase "Submit Job Application Form" as UC1
    usecase "Upload PDF Resume\n(<= 5MB Limit)" as UC2
    usecase "Validate Document\nMIME Type & Size" as UC3
    usecase "Persist Encrypted\nResume Document" as UC4
    usecase "Trigger Automated\nAI Screening Pipeline" as UC5
    usecase "Attach Optional\nCover Note" as UC6
}

Candidate --> UC1
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC6 : <<extend>>

UC5 --> AIService
@enduml
